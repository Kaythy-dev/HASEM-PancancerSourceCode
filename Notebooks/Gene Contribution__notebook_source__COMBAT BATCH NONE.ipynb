# ============================================================
# CELL 3: MSPC scoring (T2, Q), control limits from healthy-CALIBRATION,
#         evaluation on the untouched pool, ablation, source check
# ============================================================
log("Step 3: T2 and Q-residual scores, thresholds from the calibration partition...")

X_arr = X_scaled.values
X_pca_arr = pca_unsup.transform(X_arr)
X_recon   = pca_unsup.inverse_transform(X_pca_arr)
residuals = X_arr - X_recon
safe_eigen = np.where(pca_unsup.explained_variance_ <= 0, 1e-12, pca_unsup.explained_variance_)
T2_scores = np.sum((X_pca_arr ** 2) / safe_eigen, axis=1)
Q_scores  = np.sum(residuals ** 2, axis=1)

m = int(healthy_train_mask.sum())     # samples the PCA was fitted on
a = n_comp

# ── Empirical control limits: healthy-CALIBRATION samples only ──
T2_thresh_emp = np.nanpercentile(T2_scores[healthy_calib_mask], THRESH_PCT)
Q_thresh_emp  = np.nanpercentile(Q_scores[healthy_calib_mask],  THRESH_PCT)
log(f"  Empirical limits ({THRESH_PCT}th pct of calibration set, n={int(healthy_calib_mask.sum())}): "
    f"T2={T2_thresh_emp:.3f}  Q={Q_thresh_emp:.3f}")

# ── Theoretical limits (F-distribution / Jackson-Mudholkar) from the TRAIN fit ──
if m > a:
    Fcrit = f_dist.ppf(1 - ANOMALY_ALPHA, a, m - a)
    T2_thresh_theo = (a * (m - 1) * (m + 1)) / (m * (m - a)) * Fcrit
else:
    T2_thresh_theo = T2_thresh_emp
    log("  Warning: not enough training samples for theoretical T2 — using empirical.")
try:
    resid_var = np.var(residuals[healthy_train_mask], axis=0)
    th1, th2, th3 = resid_var.sum(), (resid_var**2).sum(), (resid_var**3).sum()
    h0 = 1 - (2*th1*th3) / (3*th2**2 + 1e-12)
    if h0 <= 0 or th2 <= 0:
        raise ValueError("Unstable Q parameters")
    ca = np.sqrt(2*th2*(h0**2)) / (th1 + 1e-12)
    fa_ = f_dist.ppf(1 - ANOMALY_ALPHA, max(1, round(h0*2)), max(1, round(h0*2)))
    Q_thresh_theo = th1 * ((np.sqrt(fa_)*ca + 1 + th2*h0*(h0-1)/th1**2) ** (1.0/h0))
except Exception as e:
    Q_thresh_theo = Q_thresh_emp
    log(f"  Q-theoretical fallback to empirical: {e}")
log(f"  Theoretical limits: T2={T2_thresh_theo:.3f}  Q={Q_thresh_theo:.3f}")

# ── Flags and scores ──────────────────────────────────────────
y_pred_emp  = ((T2_scores > T2_thresh_emp)  | (Q_scores > Q_thresh_emp )).astype(int)
y_pred_theo = ((T2_scores > T2_thresh_theo) | (Q_scores > Q_thresh_theo)).astype(int)
y_pred_Q    = (Q_scores > Q_thresh_emp).astype(int)

# z-normalisation uses the CALIBRATION set (unseen by the PCA fit)
T2_z = (T2_scores - T2_scores[healthy_calib_mask].mean()) / (T2_scores[healthy_calib_mask].std() + 1e-12)
Q_z  = (Q_scores  - Q_scores[healthy_calib_mask].mean())  / (Q_scores[healthy_calib_mask].std()  + 1e-12)
combined_score = (T2_z + Q_z) / 2.0





# PAPER TWO — STEP 1
# Reconstruct HASEM unsupervised anomaly scores.
# Uses the already-fitted model and transformed expression matrix.

import numpy as np
import pandas as pd

# Confirm that the model and matrix agree
assert X_scaled.shape[1] == pca_unsup.n_features_in_, (
    f"Feature mismatch: X_scaled has {X_scaled.shape[1]} genes, "
    f"but PCA expects {pca_unsup.n_features_in_}"
)

X = X_scaled.to_numpy(dtype=np.float64, copy=False)

# Project samples into the existing PCA space
scores = pca_unsup.transform(X)

# Hotelling's T²: distance within the retained PCA space
eigenvalues = pca_unsup.explained_variance_
T2 = np.sum((scores ** 2) / eigenvalues, axis=1)

# Q residual: squared reconstruction error outside the PCA space
X_reconstructed = pca_unsup.inverse_transform(scores)
residuals = X - X_reconstructed
Q = np.sum(residuals ** 2, axis=1)

# Preserve sample identifiers and original row order
sample_ids = (
    X_scaled.index.astype(str)
    if isinstance(X_scaled, pd.DataFrame)
    else pd.Index([str(i) for i in range(len(X))])
)

paper2_scores = pd.DataFrame({
    "sample_id": sample_ids,
    "T2_reconstructed": T2,
    "Q_reconstructed": Q
})

print("Samples:", len(paper2_scores))
print("Genes:", X.shape[1])
print("PCA components:", pca_unsup.n_components_)
print("Explained variance:", pca_unsup.explained_variance_ratio_.sum())

print("\nScore checks:")
print(paper2_scores[["T2_reconstructed", "Q_reconstructed"]].describe())

print("\nNon-finite T² values:", (~np.isfinite(T2)).sum())
print("Non-finite Q values:", (~np.isfinite(Q)).sum())
print("Negative T² values:", (T2 < -1e-10).sum())
print("Negative Q values:", (Q < -1e-10).sum())






# PAPER TWO — STEP 3
# Compare reconstructed scores against original Paper One scores.

import numpy as np

def compare_scores(name, original, reconstructed):
    original = np.asarray(original, dtype=np.float64).ravel()
    reconstructed = np.asarray(reconstructed, dtype=np.float64).ravel()

    assert original.shape == reconstructed.shape, (
        f"{name}: shape mismatch: {original.shape} vs {reconstructed.shape}"
    )

    diff = reconstructed - original
    abs_diff = np.abs(diff)
    denom = np.maximum(np.abs(original), 1e-12)

    print(f"\n{name}")
    print("  Max absolute difference:", abs_diff.max())
    print("  Mean absolute difference:", abs_diff.mean())
    print("  99th percentile absolute difference:",
          np.quantile(abs_diff, 0.99))
    print("  Max relative difference:", (abs_diff / denom).max())
    print("  Correlation:", np.corrcoef(original, reconstructed)[0, 1])
    print("  All close (rtol=1e-5, atol=1e-6):",
          np.allclose(original, reconstructed, rtol=1e-5, atol=1e-6))

compare_scores("T²", T2_scores, paper2_scores["T2_reconstructed"])
compare_scores("Q", Q_scores, paper2_scores["Q_reconstructed"])




