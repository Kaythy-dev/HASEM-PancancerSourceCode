        })
        continue

    tumour_rows = row_position.loc[group.index.astype(str)].to_numpy()
    healthy_rows = row_position.loc[h_group.index.astype(str)].to_numpy()

    for gene in candidate_genes:
        j = gene_to_col[gene]

        # Q contributions are squared residuals.
        q_t = q_gene_contrib[tumour_rows, j]
        q_h = q_gene_contrib[healthy_rows, j]

        # T² contributions can be signed; use absolute values for magnitude.
        t2_t = np.abs(t2_gene_contrib[tumour_rows, j])
        t2_h = np.abs(t2_gene_contrib[healthy_rows, j])

        # Difference in mean contribution: tumour minus matched healthy.
        q_diff = q_t.mean() - q_h.mean()
        t2_diff = t2_t.mean() - t2_h.mean()

        q_boot = np.empty(N_BOOT)
        t2_boot = np.empty(N_BOOT)

        for b in range(N_BOOT):
            qt = rng.choice(q_t, size=len(q_t), replace=True)
            qh = rng.choice(q_h, size=len(q_h), replace=True)
            tt = rng.choice(t2_t, size=len(t2_t), replace=True)
            th = rng.choice(t2_h, size=len(t2_h), replace=True)

            q_boot[b] = qt.mean() - qh.mean()
            t2_boot[b] = tt.mean() - th.mean()

        q_lo, q_hi = np.quantile(q_boot, [0.025, 0.975])
        t2_lo, t2_hi = np.quantile(t2_boot, [0.025, 0.975])

        results.append({
            "cancer_type": cancer_type,
            "site": site,
            "gene": gene,
            "tumour_n": len(tumour_rows),
            "healthy_n": len(healthy_rows),
            "Q_difference": q_diff,
            "Q_CI_lower": q_lo,
            "Q_CI_upper": q_hi,
            "Q_CI_positive": q_lo > 0,
            "T2_abs_difference": t2_diff,
            "T2_CI_lower": t2_lo,
            "T2_CI_upper": t2_hi,
            "T2_CI_positive": t2_lo > 0,
            "status": "Included"
        })

matched_results = pd.DataFrame(results)

output_dir = "/kaggle/working/paper2_gene_attribution"
import os
os.makedirs(output_dir, exist_ok=True)

matched_results.to_csv(
    f"{output_dir}/tissue_matched_candidate_attribution.csv",
    index=False
)

included = matched_results[
    matched_results["status"].eq("Included")
].copy()

print("MATCHED COMPARISONS")
print("Cancer types included:", included["cancer_type"].nunique())
print("Cancer type-gene comparisons:", len(included))

print("\nREFERENCE SAMPLE COUNTS")
print(
    matched_results[
        ["cancer_type", "site", "tumour_n", "healthy_n", "status"]
    ].drop_duplicates().to_string(index=False)
)

print("\nSUMMARY BY GENE")
if not included.empty:
    summary = included.groupby("gene").agg(
        cancer_types=("cancer_type", "nunique"),
        Q_positive_differences=("Q_difference", lambda x: int((x > 0).sum())),
        Q_positive_CIs=("Q_CI_positive", "sum"),
        median_Q_difference=("Q_difference", "median"),
        T2_positive_differences=("T2_abs_difference", lambda x: int((x > 0).sum())),
        T2_positive_CIs=("T2_CI_positive", "sum"),
        median_T2_abs_difference=("T2_abs_difference", "median")
    ).reset_index()

    print(summary.to_string(index=False))
    summary.to_csv(
        f"{output_dir}/tissue_matched_candidate_summary.csv",
        index=False
    )
else:
    print("No cancer types met the matched-reference sample threshold.")






