def wilson_ci(k, n, z=1.96):
    """Wilson score 95% confidence interval for a proportion, in percent."""
    if n == 0:
        return np.nan, np.nan
    p = k / n
    denom = 1 + z**2 / n
    centre = (p + z**2 / (2*n)) / denom
    margin = (z * np.sqrt(p*(1-p)/n + z**2/(4*n**2))) / denom
    return round(max(0.0, (centre - margin)*100), 2), round(min(100.0, (centre + margin)*100), 2)

def compute_T2(Xpca, eigenvals):
    safe = np.where(eigenvals <= 0, 1e-12, eigenvals)
    return np.sum((Xpca**2) / safe, axis=1)

