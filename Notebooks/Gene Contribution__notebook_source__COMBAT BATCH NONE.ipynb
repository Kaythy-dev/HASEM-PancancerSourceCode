# Recover the tissue-matched comparisons from the existing attribution output.
import os
import pandas as pd

out = "/kaggle/working/paper2_gene_attribution"

source_file = os.path.join(
    out, "tissue_matched_candidate_attribution.csv"
)
consolidated_file = os.path.join(
    out, "Paper2_tissue_matched_consolidated.csv"
)

if not os.path.exists(source_file):
    raise FileNotFoundError(
        f"Cannot find {source_file}. "
        "Check that the tissue-matched attribution cell ran successfully."
    )

candidate = pd.read_csv(source_file)

# Inspect the eligibility/status labels before filtering.
if "status" not in candidate.columns:
    raise ValueError(
        f"Expected a 'status' column. Found: {candidate.columns.tolist()}"
    )

print("Status counts:")
print(candidate["status"].value_counts(dropna=False))

included = candidate.loc[
    candidate["status"].astype(str).str.strip().str.lower().eq("included")
].copy()

if included.empty:
    raise ValueError(
        "No rows have status='included'. Check the status counts above "
        "and adjust the filter to match the actual eligibility labels."
    )

consolidated = included.copy()
consolidated.to_csv(consolidated_file, index=False)

print("Consolidated comparisons:", len(consolidated))
print("Cancer types:", consolidated["cancer_type"].nunique())
print("Saved:", consolidated_file)


def bootstrap_median_difference(tumour_values, healthy_values, n_boot, rng):
    """Tumour median minus healthy median, with separate group bootstraps."""
    a = np.asarray(tumour_values, dtype=float)
    b = np.asarray(healthy_values, dtype=float)

    observed = np.median(a) - np.median(b)
    boot_diffs = np.empty(n_boot)

    for i in range(n_boot):
        a_sample = rng.choice(a, size=len(a), replace=True)
        b_sample = rng.choice(b, size=len(b), replace=True)
        boot_diffs[i] = np.median(a_sample) - np.median(b_sample)

    lo, hi = np.quantile(boot_diffs, [0.025, 0.975])

    return {
        "median_difference": observed,
        "bootstrap_CI_lower": lo,
        "bootstrap_CI_upper": hi,
        "CI_above_zero": bool(lo > 0),
        "CI_below_zero": bool(hi < 0),
        "bootstrap_fraction_positive": float(np.mean(boot_diffs > 0))
    }
# Define comparisons explicitly before the bootstrap loop
consolidated = pd.read_csv(
    os.path.join(out, "Paper2_tissue_matched_consolidated.csv")
)

comparisons = consolidated[
    ["cancer_type", "site", "gene"]
].drop_duplicates()

print("Comparisons to bootstrap:", len(comparisons))


records = []

for _, comp in comparisons.iterrows():
    cancer_type = comp["cancer_type"]
    site = comp["site"]
    gene = comp["gene"]

    tg = tumours[
        tumours["detailed_category"].eq(cancer_type)
        & tumours["_primary_site"].eq(site)
    ]
    hg = healthy[healthy["_primary_site"].eq(site)]

    tumour_rows = row_position.loc[tg.index.astype(str)].to_numpy()
    healthy_rows = row_position.loc[hg.index.astype(str)].to_numpy()
    j = gene_to_col[gene]

    metric_values = {
        "Q": (
            q_gene_contrib[tumour_rows, j],
            q_gene_contrib[healthy_rows, j]
        ),
        "absolute_T2": (
            np.abs(t2_gene_contrib[tumour_rows, j]),
            np.abs(t2_gene_contrib[healthy_rows, j])
        )
    }

    for metric, (a, b) in metric_values.items():
        result = bootstrap_median_difference(a, b, N_BOOT, rng)

        records.append({
            "cancer_type": cancer_type,
            "site": site,
            "gene": gene,
            "metric": metric,
            "tumour_n": len(a),
            "healthy_n": len(b),
            "tumour_median": np.median(a),
            "healthy_median": np.median(b),
            **result
        })

robust_medians = pd.DataFrame(records)


# Add gene symbols without relying on a missing annotation file
gene_symbol_map = {
    "ENSG00000196616": "ADH1B",
    "ENSG00000071991": "CDH19",
    "ENSG00000153253": "SCN3A",
    "ENSG00000164530": "PI16",
    "ENSG00000167434": "CA4",
    "ENSG00000182836": "PLCXD3",
    "ENSG00000236333": "TRHDE-AS1",
    "ENSG00000109906": "ZBTB16",
}

robust_medians["_join_id"] = (
    robust_medians["gene"].astype(str).str.split(".").str[0]
)

robust_medians["gene_symbol"] = robust_medians["_join_id"].map(
    gene_symbol_map
)

unmapped = robust_medians.loc[
    robust_medians["gene_symbol"].isna(), "gene"
].unique()

if len(unmapped):
    print("Warning: gene symbols not mapped:", unmapped)

robust_medians = robust_medians.drop(columns="_join_id")

# Save comparison-level results
detail_path = os.path.join(
    out, "Paper2_median_difference_bootstrap.csv"
)
robust_medians.to_csv(detail_path, index=False)

# Summarise direction and interval stability by gene and score
summary = robust_medians.groupby(
    ["gene_symbol", "gene", "metric"], dropna=False
).agg(
    cancer_types=("cancer_type", "nunique"),
    positive_median_differences=(
        "median_difference", lambda x: int((x > 0).sum())
    ),
    positive_CIs=("CI_above_zero", "sum"),
    negative_CIs=("CI_below_zero", "sum"),
    median_of_median_differences=("median_difference", "median"),
    median_fraction_positive=("bootstrap_fraction_positive", "median")
).reset_index()

summary_path = os.path.join(
    out, "Paper2_median_difference_bootstrap_summary.csv"
)
summary.to_csv(summary_path, index=False)

print("COMPARISONS:", len(robust_medians))
print("Genes:", robust_medians["gene"].nunique())
print("Cancer types:", robust_medians["cancer_type"].nunique())
print("Bootstrap replicates per comparison:", N_BOOT)

print("\nSUMMARY BY GENE AND SCORE")
print(summary.to_string(index=False))

print("\nCOMPARISONS WITH MEDIAN DIFFERENCE CI NOT ABOVE ZERO")
not_positive = robust_medians[~robust_medians["CI_above_zero"]]
print(
    not_positive[
        [
            "gene_symbol", "cancer_type", "metric",
            "tumour_n", "healthy_n", "median_difference",
            "bootstrap_CI_lower", "bootstrap_CI_upper"
        ]
    ].to_string(index=False)
)

print("\nSaved detail:", detail_path)
print("Saved summary:", summary_path)






import numpy as np
import pandas as pd
import os

# Settings
N_REPEATS = 5000
MIN_HEALTHY_N = 5
rng = np.random.default_rng(20261024)

output_dir = "/kaggle/working/paper2_gene_attribution"
os.makedirs(output_dir, exist_ok=True)

# Reconstruct the same analysis cohorts
meta_aligned = meta.reindex(X_scaled.index.astype(str)).copy()
healthy_holdout_ids = set(pd.Index(healthy_holdout).astype(str))

healthy = meta_aligned[
    meta_aligned["is_healthy"].fillna(False).astype(bool)
    & meta_aligned["source"].eq("TCGA")
    & meta_aligned.index.astype(str).isin(healthy_holdout_ids)
].copy()

tumours = meta_aligned[
    meta_aligned["partition"].eq("tumour")
    & meta_aligned["is_primary_tumour"].fillna(False).astype(bool)
].copy()

sample_ids = X_scaled.index.astype(str)
row_position = pd.Series(np.arange(len(sample_ids)), index=sample_ids)
gene_to_col = {
    g: i for i, g in enumerate(X_scaled.columns.astype(str))
}

candidate_genes = [
    "ENSG00000196616.12",  # ADH1B
    "ENSG00000071991.8",   # CDH19
    "ENSG00000153253.15",  # SCN3A
    "ENSG00000164530.13",  # PI16
    "ENSG00000167434.9",   # CA4
    "ENSG00000182836.9",   # PLCXD3
    "ENSG00000236333.3",   # TRHDE-AS1
    "ENSG00000109906.13",  # ZBTB16
]

assert q_gene_contrib.shape == X_scaled.shape
assert t2_gene_contrib.shape == X_scaled.shape

records = []

for cancer_type, tumour_group in tumours.groupby(
    "detailed_category", dropna=False
):
    sites = tumour_group["_primary_site"].dropna().unique()

    if len(sites) != 1:
        continue

    site = sites[0]
    healthy_group = healthy[healthy["_primary_site"].eq(site)]
    healthy_n = len(healthy_group)

    if healthy_n < MIN_HEALTHY_N:
        continue

    tumour_rows = row_position.loc[
        tumour_group.index.astype(str)
    ].to_numpy()

    healthy_rows = row_position.loc[
        healthy_group.index.astype(str)
    ].to_numpy()

    if len(tumour_rows) < healthy_n:
        continue

    for gene in candidate_genes:
        j = gene_to_col[gene]

        q_t = q_gene_contrib[tumour_rows, j]
        q_h = q_gene_contrib[healthy_rows, j]

        t2_t = np.abs(t2_gene_contrib[tumour_rows, j])
        t2_h = np.abs(t2_gene_contrib[healthy_rows, j])

        q_diffs = np.empty(N_REPEATS)
        t2_diffs = np.empty(N_REPEATS)

        for b in range(N_REPEATS):
            # Equal-sized tumour subsample, without replacement
            ti = rng.choice(
                len(tumour_rows),
                size=healthy_n,
                replace=False
            )

            # Equal-sized healthy bootstrap sample, with replacement
            hi = rng.choice(
                len(healthy_rows),
                size=healthy_n,
                replace=True
            )

            q_diffs[b] = np.mean(q_t[ti]) - np.mean(q_h[hi])
            t2_diffs[b] = np.mean(t2_t[ti]) - np.mean(t2_h[hi])

        records.append({
            "cancer_type": cancer_type,
            "site": site,
            "gene": gene,
            "tumour_n": len(tumour_rows),
            "healthy_n": healthy_n,
            "repeats": N_REPEATS,

            "Q_fraction_positive": np.mean(q_diffs > 0),
            "Q_repeat_median": np.median(q_diffs),
            "Q_repeat_2.5pct": np.quantile(q_diffs, 0.025),
            "Q_repeat_97.5pct": np.quantile(q_diffs, 0.975),

            "T2_fraction_positive": np.mean(t2_diffs > 0),
            "T2_repeat_median": np.median(t2_diffs),
            "T2_repeat_2.5pct": np.quantile(t2_diffs, 0.025),
            "T2_repeat_97.5pct": np.quantile(t2_diffs, 0.975),
        })

robustness_equal_n = pd.DataFrame(records)

detail_path = os.path.join(
    output_dir, "tissue_matched_equal_n_robustness.csv"
)
robustness_equal_n.to_csv(detail_path, index=False)

if robustness_equal_n.empty:
    print("No comparisons met the eligibility criteria.")
else:
    for metric in ["Q", "T2"]:
        lower = robustness_equal_n[f"{metric}_repeat_2.5pct"]
        upper = robustness_equal_n[f"{metric}_repeat_97.5pct"]
        fraction = robustness_equal_n[f"{metric}_fraction_positive"]

        print(f"\n{metric} results")
        print("Comparisons:", len(robustness_equal_n))
        print("Intervals entirely above zero:", int((lower > 0).sum()))
        print("Intervals entirely below zero:", int((upper < 0).sum()))
        print(
            "Intervals crossing zero:",
            int(((lower <= 0) & (upper >= 0)).sum())
        )
        print("Positive fraction >= 95%:", int((fraction >= 0.95).sum()))

    summary = robustness_equal_n.groupby("gene").agg(
        cancer_types=("cancer_type", "nunique"),
        Q_positive_intervals=(
            "Q_repeat_2.5pct", lambda x: int((x > 0).sum())
        ),
        Q_median_fraction_positive=("Q_fraction_positive", "median"),
        T2_positive_intervals=(
            "T2_repeat_2.5pct", lambda x: int((x > 0).sum())
        ),
        T2_median_fraction_positive=("T2_fraction_positive", "median"),
    ).reset_index()

    summary_path = os.path.join(
        output_dir, "tissue_matched_equal_n_robustness_summary.csv"
    )
    summary.to_csv(summary_path, index=False)

    print("\nSummary by gene:")
    print(summary.to_string(index=False))
    print("\nSaved:", detail_path)
    print("Saved:", summary_path)





import pandas as pd
import numpy as np
import os

out_dir = "/kaggle/working/paper2_gene_attribution"

# Load both analyses
median = pd.read_csv(
    f"{out_dir}/Paper2_median_difference_bootstrap.csv"
)
equal_n = pd.read_csv(
    f"{out_dir}/tissue_matched_equal_n_robustness.csv"
)

# Check the expected comparison structure
keys = ["cancer_type", "gene"]
assert not median.duplicated(keys + ["metric"]).any()
assert not equal_n.duplicated(keys).any()

# Convert median-bootstrap results from long to wide format
median_wide = median.pivot(
    index=keys,
    columns="metric",
    values=["median_difference", "bootstrap_CI_lower",
            "bootstrap_CI_upper"]
)
median_wide.columns = [
    f"{stat}_{metric}" for stat, metric in median_wide.columns
]
median_wide = median_wide.reset_index()

# Keep the equal-sized resampling results needed for comparison
equal_keep = equal_n[
    keys + [
        "healthy_n",
        "Q_repeat_median", "Q_repeat_2.5pct", "Q_repeat_97.5pct",
        "Q_fraction_positive",
        "T2_repeat_median", "T2_repeat_2.5pct", "T2_repeat_97.5pct",
        "T2_fraction_positive",
    ]
].copy()

combined = median_wide.merge(
    equal_keep, on=keys, how="inner", validate="one_to_one"
)

# Directional agreement across the two approaches
for metric, equal_prefix in [("Q", "Q"), ("absolute_T2", "T2")]:
    median_diff = combined[f"median_difference_{metric}"]
    median_lo = combined[f"bootstrap_CI_lower_{metric}"]
    equal_lo = combined[f"{equal_prefix}_repeat_2.5pct"]
    equal_hi = combined[f"{equal_prefix}_repeat_97.5pct"]

    combined[f"{metric}_both_medians_positive"] = (
        (median_diff > 0) &
        (combined[f"{equal_prefix}_repeat_median"] > 0)
    )

    combined[f"{metric}_both_intervals_above_zero"] = (
        (median_lo > 0) & (equal_lo > 0)
    )

    # Both interval upper bounds are included for transparent auditing
    combined[f"{metric}_median_CI_upper"] = (
        combined[f"bootstrap_CI_upper_{metric}"]
    )
    combined[f"{metric}_equal_n_CI_upper"] = equal_hi

# Summarise the strongest descriptive evidence
summary_rows = []
for metric in ["Q", "absolute_T2"]:
    summary_rows.append({
        "metric": metric,
        "comparisons": len(combined),
        "both_median_differences_positive": int(
            combined[f"{metric}_both_medians_positive"].sum()
        ),
        "both_intervals_entirely_above_zero": int(
            combined[f"{metric}_both_intervals_above_zero"].sum()
        ),
    })

summary = pd.DataFrame(summary_rows)

combined_path = os.path.join(
    out_dir, "Paper2_robustness_comparison.csv"
)
summary_path = os.path.join(
    out_dir, "Paper2_robustness_comparison_summary.csv"
)

combined.to_csv(combined_path, index=False)
summary.to_csv(summary_path, index=False)

print("COMPARISON SUMMARY")
print(summary.to_string(index=False))

print("\nExample strongest Q comparisons:")
print(
    combined.loc[
        combined["Q_both_intervals_above_zero"],
        ["cancer_type", "gene", "median_difference_Q",
         "Q_repeat_median", "Q_repeat_2.5pct", "Q_repeat_97.5pct"]
    ].head(15).to_string(index=False)
)

print("\nSaved:")
print(combined_path)
print(summary_path)





import pandas as pd
import numpy as np

out_dir = "/kaggle/working/paper2_gene_attribution"

median = pd.read_csv(
    f"{out_dir}/Paper2_median_difference_bootstrap.csv"
)
equal_n = pd.read_csv(
    f"{out_dir}/tissue_matched_equal_n_robustness.csv"
)

keys = ["cancer_type", "gene"]

median_wide = median.pivot(
    index=keys,
    columns="metric",
    values=[
        "median_difference",
        "bootstrap_CI_lower",
        "bootstrap_CI_upper",
    ],
)
median_wide.columns = [
    f"{stat}_{metric}" for stat, metric in median_wide.columns
]
median_wide = median_wide.reset_index()

combined = median_wide.merge(
    equal_n,
    on=keys,
    how="inner",
    validate="one_to_one",
)

# Compare median-difference directions and interval support
for metric, equal_prefix in [("Q", "Q"), ("absolute_T2", "T2")]:
    original_diff = combined[f"median_difference_{metric}"]
    equal_diff = combined[f"{equal_prefix}_repeat_median"]

    combined[f"{metric}_median_direction_agrees"] = (
        np.sign(original_diff) == np.sign(equal_diff)
    )
    combined[f"{metric}_both_medians_positive"] = (
        (original_diff > 0) & (equal_diff > 0)
    )
    combined[f"{metric}_both_intervals_positive"] = (
        (combined[f"bootstrap_CI_lower_{metric}"] > 0)
        & (combined[f"{equal_prefix}_repeat_2.5pct"] > 0)
    )

for metric in ["Q", "absolute_T2"]:
    print(f"\n{'='*75}\n{metric}: MEDIAN-DIRECTION DISAGREEMENTS")
    disagree = combined.loc[
        ~combined[f"{metric}_median_direction_agrees"],
        [
            "cancer_type", "gene",
            f"median_difference_{metric}",
            f"bootstrap_CI_lower_{metric}",
            f"bootstrap_CI_upper_{metric}",
            f"{'Q' if metric == 'Q' else 'T2'}_repeat_median",
            f"{'Q' if metric == 'Q' else 'T2'}_repeat_2.5pct",
            f"{'Q' if metric == 'Q' else 'T2'}_repeat_97.5pct",
        ],
    ]
    print("Number:", len(disagree))
    print(disagree.to_string(index=False) if len(disagree) else "None")

    print(f"\n{metric}: POSITIVE MEDIANS, BUT NOT BOTH INTERVALS ABOVE ZERO")
    uncertain = combined.loc[
        combined[f"{metric}_both_medians_positive"]
        & ~combined[f"{metric}_both_intervals_positive"],
        [
            "cancer_type", "gene",
            f"median_difference_{metric}",
            f"bootstrap_CI_lower_{metric}",
            f"bootstrap_CI_upper_{metric}",
            f"{'Q' if metric == 'Q' else 'T2'}_repeat_median",
            f"{'Q' if metric == 'Q' else 'T2'}_repeat_2.5pct",
            f"{'Q' if metric == 'Q' else 'T2'}_repeat_97.5pct",
        ],
    ]
    print("Number:", len(uncertain))
    print(uncertain.to_string(index=False) if len(uncertain) else "None")

# Save a compact audit table
audit_path = f"{out_dir}/Paper2_robustness_exceptions.csv"
combined.to_csv(audit_path, index=False)
print("\nFull comparison saved to:", audit_path)



