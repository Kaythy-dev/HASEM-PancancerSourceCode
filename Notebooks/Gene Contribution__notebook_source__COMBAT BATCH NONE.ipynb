import numpy as np
import pandas as pd
from pathlib import Path

# PCA scores and feature matrix must be in the same row order.
X = X_scaled.to_numpy(dtype=np.float64, copy=False)
X_centered = X - pca_unsup.mean_
scores = pca_unsup.transform(X)
eigenvalues = pca_unsup.explained_variance_
loadings = pca_unsup.components_

# Signed feature-level decomposition:
# contribution_ig = centered_X_ig * sum_k(score_ik * loading_kg / eigenvalue_k)
weighted_scores = scores / eigenvalues
t2_gene_contrib = X_centered * (weighted_scores @ loadings)

# Validate the identity: sum over genes = sample T².
t2_reconstructed = np.sum(t2_gene_contrib, axis=1)
t2_reference = np.asarray(T2_scores).reshape(-1)

max_abs_error = np.max(np.abs(t2_reconstructed - t2_reference))
print("Maximum absolute T² reconstruction error:", max_abs_error)
assert np.allclose(t2_reconstructed, t2_reference, rtol=1e-6, atol=1e-6), (
    "T² gene contributions do not reproduce the reference scores."
)

# Use the same leakage-safe tumour and healthy holdout groups.
meta_aligned = meta.reindex(X_scaled.index.astype(str)).copy()
assert meta_aligned.index.astype(str).equals(X_scaled.index.astype(str)), (
    "Metadata and expression sample order do not match."
)
tumour_mask = (
    meta_aligned["partition"].eq("tumour")
    & meta_aligned["is_primary_tumour"].fillna(False).astype(bool)
)
healthy_mask = (
    meta_aligned["is_healthy"].fillna(False).astype(bool)
    & meta_aligned["partition"].eq("healthy_holdout")
)
tcga_healthy_mask = healthy_mask & meta_aligned["source"].eq("TCGA")
gtex_healthy_mask = healthy_mask & meta_aligned["source"].eq("GTEx")

def group_summary(mask):
    idx = np.flatnonzero(mask.to_numpy())
    values = t2_gene_contrib[idx]
    return {
        "mean_signed": values.mean(axis=0),
        "mean_absolute": np.abs(values).mean(axis=0),
        "n_samples": len(idx),
    }

tumour = group_summary(tumour_mask)
tcga_normal = group_summary(tcga_healthy_mask)
gtex_normal = group_summary(gtex_healthy_mask)

genes = X_scaled.columns.astype(str)
t2_summary = pd.DataFrame({
    "gene": genes,
    "tumour_mean_signed_T2_contribution": tumour["mean_signed"],
    "tumour_mean_absolute_T2_contribution": tumour["mean_absolute"],
    "TCGA_healthy_mean_absolute_T2_contribution": tcga_normal["mean_absolute"],
    "GTEx_healthy_mean_absolute_T2_contribution": gtex_normal["mean_absolute"],
})

# Absolute contributions rank attribution magnitude; signed values preserve
# the exact additive decomposition and can be negative.
t2_summary["tumour_minus_TCGA_mean_absolute"] = (
    t2_summary["tumour_mean_absolute_T2_contribution"]
    - t2_summary["TCGA_healthy_mean_absolute_T2_contribution"]
)
t2_summary["tumour_minus_GTEx_mean_absolute"] = (
    t2_summary["tumour_mean_absolute_T2_contribution"]
    - t2_summary["GTEx_healthy_mean_absolute_T2_contribution"]
)

out_dir = Path("/kaggle/working/paper2_gene_attribution")
out_dir.mkdir(parents=True, exist_ok=True)
out_path = out_dir / "T2_gene_contribution_summary.csv"

t2_summary.sort_values(
    "tumour_minus_TCGA_mean_absolute", ascending=False
).to_csv(out_path, index=False)

print("\nGroup sizes:")
print("Eligible tumours:", tumour["n_samples"])
print("TCGA healthy holdout:", tcga_normal["n_samples"])
print("GTEx healthy holdout:", gtex_normal["n_samples"])

print("\nTop 20 genes by tumour minus TCGA healthy mean absolute T² contribution:")
print(
    t2_summary.sort_values(
        "tumour_minus_TCGA_mean_absolute", ascending=False
    ).head(20).to_string(index=False)
)
print("\nSaved:", out_path)





