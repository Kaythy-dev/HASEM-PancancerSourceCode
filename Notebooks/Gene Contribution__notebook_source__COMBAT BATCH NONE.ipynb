# PAPER TWO — FULL-GENE BENCHMARK INPUT
# Creates new objects; does not modify existing results.

import numpy as np
import pandas as pd

candidate_ids = {
    "ADH1B": "ENSG00000196616.12",
    "CDH19": "ENSG00000071991.8",
    "SCN3A": "ENSG00000153253.15",
    "PI16": "ENSG00000164530.13",
    "CA4": "ENSG00000167434.9",
    "PLCXD3": "ENSG00000182836.9",
    "TRHDE-AS1": "ENSG00000236333.3",
    "ZBTB16": "ENSG00000109906.13",
}

# Preserve the existing ten cancer types and anatomical-site definitions.
cancer_sites = (
    res[["cancer_type", "site"]]
    .drop_duplicates()
    .sort_values(["site", "cancer_type"])
    .reset_index(drop=True)
)

# Align metadata to the expression matrix by sample ID.
meta_bench = meta.reindex(X_scaled.index)

if meta_bench.index.isna().any():
    raise ValueError("Metadata alignment failed.")

if not meta_bench.index.equals(X_scaled.index):
    raise ValueError("Metadata index does not match X_scaled.")

# Confirm contribution arrays align by shape.
if q_gene_contrib.shape != X_scaled.shape:
    raise ValueError("Q contribution shape mismatch.")

if abs(t2_gene_contrib).shape != X_scaled.shape:
    raise ValueError("T2 contribution shape mismatch.")

# Restrict to the existing eligible tumour cohort and healthy holdout.
tumour_mask = (
    meta_bench["partition"].eq("tumour")
    & meta_bench["is_tumor"].eq(1)
)
healthy_mask = (
    meta_bench["partition"].eq("healthy_holdout")
    & meta_bench["_sample_type"].eq("Solid Tissue Normal")
)

print("Eligible tumour samples:", int(tumour_mask.sum()))
print("Healthy holdout samples:", int(healthy_mask.sum()))

gene_ids = list(X_scaled.columns)
gene_to_idx = {gene: i for i, gene in enumerate(gene_ids)}

missing_candidates = [
    (symbol, gene_id)
    for symbol, gene_id in candidate_ids.items()
    if gene_id not in gene_to_idx
]
if missing_candidates:
    raise ValueError(f"Candidate IDs missing: {missing_candidates}")

# Calculate median differences for each gene, cancer type, and metric.
benchmark_rows = []

for _, item in cancer_sites.iterrows():
    cancer_type = item["cancer_type"]
    site = item["site"]

    tumour_idx = meta_bench.index[
        tumour_mask
        & meta_bench["primary disease or tissue"].eq(cancer_type)
    ]

    healthy_idx = meta_bench.index[
        healthy_mask
        & meta_bench["_primary_site"].eq(site)
    ]

    if len(tumour_idx) == 0 or len(healthy_idx) == 0:
        print(
            f"Skipping {cancer_type}: "
            f"tumour n={len(tumour_idx)}, healthy n={len(healthy_idx)}"
        )
        continue

    tumour_pos = X_scaled.index.get_indexer(tumour_idx)
    healthy_pos = X_scaled.index.get_indexer(healthy_idx)

    for gene_idx, gene_id in enumerate(gene_ids):
        q_tumour = q_gene_contrib[tumour_pos, gene_idx]
        q_healthy = q_gene_contrib[healthy_pos, gene_idx]

        t2_tumour = abs(t2_gene_contrib[tumour_pos, gene_idx])
        t2_healthy = abs(t2_gene_contrib[healthy_pos, gene_idx])

        benchmark_rows.append({
            "cancer_type": cancer_type,
            "site": site,
            "gene": gene_id,
            "metric": "Q",
            "tumour_n": len(tumour_pos),
            "healthy_n": len(healthy_pos),
            "tumour_median": float(np.median(q_tumour)),
            "healthy_median": float(np.median(q_healthy)),
            "median_difference": float(
                np.median(q_tumour) - np.median(q_healthy)
            ),
        })

        benchmark_rows.append({
            "cancer_type": cancer_type,
            "site": site,
            "gene": gene_id,
            "metric": "absolute_T2",
            "tumour_n": len(tumour_pos),
            "healthy_n": len(healthy_pos),
            "tumour_median": float(np.median(t2_tumour)),
            "healthy_median": float(np.median(t2_healthy)),
            "median_difference": float(
                np.median(t2_tumour) - np.median(t2_healthy)
            ),
        })

benchmark_all_genes = pd.DataFrame(benchmark_rows)

print("\nBenchmark table shape:", benchmark_all_genes.shape)
print("Unique genes:", benchmark_all_genes["gene"].nunique())
print("Cancer types:", benchmark_all_genes["cancer_type"].nunique())
print("\nRows per metric:")
print(benchmark_all_genes["metric"].value_counts().to_string())

print("\nCandidate gene coverage:")
for symbol, gene_id in candidate_ids.items():
    print(
        symbol,
        "| rows:",
        int((benchmark_all_genes["gene"] == gene_id).sum())
    )

print("\nSample of benchmark table:")
print(benchmark_all_genes.head(10).to_string(index=False))


