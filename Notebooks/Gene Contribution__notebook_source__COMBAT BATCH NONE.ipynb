log("Step 1: metadata, patient-aware split, feature selection...")

# ── 1a. Load and align metadata ──────────────────────────────
meta = pd.read_csv(PHENO_PATH, sep="\t", encoding="latin1", low_memory=False)
meta.rename(
    columns={
        "sample_type": "_sample_type",
        "primary_site": "_primary_site",
        "Sample": "sample"
    },
    inplace=True
)
meta = meta.set_index("sample", drop=False)

expr_cols = pd.read_csv(EXPR_PATH, sep="\t", index_col=0, nrows=0).columns
meta = meta.loc[meta.index.isin(expr_cols)].copy()

# ── 1b. Conservative sample labels ───────────────────────────
sample_type = meta["_sample_type"].fillna("").astype(str).str.strip()

meta["is_healthy"] = sample_type.isin(
    ["Normal Tissue", "Solid Tissue Normal"]
)
meta["is_primary_tumour"] = sample_type.eq("Primary Tumor")
meta["eligible_primary_analysis"] = (
    meta["is_healthy"] | meta["is_primary_tumour"]
)

if "_study" in meta.columns:
    study = meta["_study"].fillna("").astype(str).str.upper()
    meta["source"] = np.select(
        [
            study.str.contains("GTEX"),
            study.str.contains("TARGET"),
            study.str.contains("TCGA")
        ],
        ["GTEx", "TARGET", "TCGA"],
        default="Unknown"
    )
else:
    meta["source"] = "Unknown"

meta = meta.loc[meta["eligible_primary_analysis"]].copy()
meta["is_tumor"] = meta["is_primary_tumour"].astype(int)


# Patient IDs: group all samples from the same participant.
sample_ids = pd.Series(meta.index.astype(str), index=meta.index)

tcga_patient = sample_ids.str.extract(
    r"^(TCGA-[A-Z0-9]+-[A-Z0-9]+)", expand=False
)
gtex_donor = sample_ids.str.extract(
    r"^(GTEX-[A-Z0-9]+)", expand=False
)

meta["patient_group"] = sample_ids.copy()

tcga_mask = meta["source"].eq("TCGA")
gtex_mask = meta["source"].eq("GTEx")

meta.loc[tcga_mask, "patient_group"] = (
    tcga_patient.loc[tcga_mask]
    .fillna(sample_ids.loc[tcga_mask])
)

meta.loc[gtex_mask, "patient_group"] = (
    gtex_donor.loc[gtex_mask]
    .fillna(sample_ids.loc[gtex_mask])
)

log(f"Eligible healthy tissues: {int(meta['is_healthy'].sum()):,}")
log(f"Eligible primary tumours: {int(meta['is_primary_tumour'].sum()):,}")
log(f"Source counts: {meta['source'].value_counts().to_dict()}")

# Split healthy patient/donor groups ONCE, preserving source representation.
# This avoids the previous duplicated split block and avoids a random fallback
# that could place all TCGA normals into a single partition.
healthy_meta = meta.loc[meta["is_healthy"]].copy()

patient_table = (
    healthy_meta[["patient_group", "source"]]
    .drop_duplicates("patient_group")
    .set_index("patient_group")
)
f_tr, f_ca, f_ho = SPLIT_FRACTIONS
assert abs((f_tr + f_ca + f_ho) - 1.0) < 1e-8

train_groups, calib_groups, holdout_groups = [], [], []
for source_name, source_table in patient_table.groupby("source", sort=True):
    source_groups = source_table.index.to_numpy()
    n_groups = len(source_groups)
    if n_groups < 3:
        raise ValueError(
            f"Cannot place source {source_name!r} into train/calibration/holdout "
            f"with only {n_groups} independent patient/donor groups."
        )

    # Split independently within each source, keeping each source represented
    # across all three partitions while never splitting a patient/donor.
    train_g, rest_g = train_test_split(
        source_groups,
        test_size=(f_ca + f_ho),
        random_state=RANDOM_SEED,
        shuffle=True,
    )
    calib_g, holdout_g = train_test_split(
        rest_g,
        test_size=f_ho / (f_ca + f_ho),
        random_state=RANDOM_SEED,
        shuffle=True,
    )
    train_groups.extend(train_g.tolist())
    calib_groups.extend(calib_g.tolist())
    holdout_groups.extend(holdout_g.tolist())

healthy_train_groups = set(train_groups)
healthy_calib_groups = set(calib_groups)
healthy_holdout_groups = set(holdout_groups)

assert not (healthy_train_groups & healthy_calib_groups)
assert not (healthy_train_groups & healthy_holdout_groups)
assert not (healthy_calib_groups & healthy_holdout_groups)
assert healthy_train_groups | healthy_calib_groups | healthy_holdout_groups == set(patient_table.index)

meta["partition"] = "excluded"
meta.loc[meta["is_primary_tumour"], "partition"] = "tumour"
meta.loc[
    meta["is_healthy"] & meta["patient_group"].isin(healthy_train_groups),
    "partition",
] = "healthy_train"
meta.loc[
    meta["is_healthy"] & meta["patient_group"].isin(healthy_calib_groups),
    "partition",
] = "healthy_calib"
meta.loc[
    meta["is_healthy"] & meta["patient_group"].isin(healthy_holdout_groups),
    "partition",
] = "healthy_holdout"

# Exclude TCGA tumours from every patient represented in any healthy partition.
# This is deliberately conservative and prevents same-patient tumour/normal leakage.
protected_groups = healthy_train_groups | healthy_calib_groups | healthy_holdout_groups
tcga_tumour = meta["is_primary_tumour"] & meta["source"].eq("TCGA")
exclude_tcga_tumour = tcga_tumour & meta["patient_group"].isin(protected_groups)
meta.loc[exclude_tcga_tumour, "partition"] = "tumour_patient_overlap_excluded"

# Keep non-TCGA primary tumours as a separate evaluation cohort.
meta.loc[
    meta["is_primary_tumour"] & ~meta["source"].eq("TCGA"),
    "partition",
] = "tumour"

# Materialize sample IDs for the remaining HASEM steps.
healthy_train = meta.index[meta["partition"].eq("healthy_train")].to_numpy()
healthy_calib = meta.index[meta["partition"].eq("healthy_calib")].to_numpy()
healthy_holdout = meta.index[meta["partition"].eq("healthy_holdout")].to_numpy()
train_set = set(healthy_train)
calib_set = set(healthy_calib)
holdout_set = set(healthy_holdout)

# Source-by-partition audit: fail loudly if any sufficiently large source
# is missing from a partition instead of silently accepting an invalid split.
source_partition_counts = pd.crosstab(meta.loc[meta["is_healthy"], "source"],
                                      meta.loc[meta["is_healthy"], "partition"])
log("Healthy source-by-partition counts:")
log(source_partition_counts.to_string())
for source_name, row in source_partition_counts.iterrows():
    if int(row.sum()) >= 3:
        for partition_name in ["healthy_train", "healthy_calib", "healthy_holdout"]:
            assert int(row.get(partition_name, 0)) > 0, (
                f"Source {source_name!r} is absent from {partition_name}."
            )

# Save complete manifest, including excluded samples.
meta[["partition", "source", "patient_group"]].to_csv(
    os.path.join(OUTDIR, "models", "split_manifest.csv")
)

healthy_train = meta.index[meta["partition"] == "healthy_train"].to_numpy()
healthy_calib = meta.index[meta["partition"] == "healthy_calib"].to_numpy()
healthy_holdout = meta.index[meta["partition"] == "healthy_holdout"].to_numpy()
train_set = set(healthy_train)

# ── 1e. Select variable genes using healthy TRAIN only ────────
log("Computing MAD on healthy training samples only...")
mad_scores = []

with pd.read_csv(
    EXPR_PATH, sep="\t", index_col=0, chunksize=CHUNK_SIZE,
    engine="c", dtype_backend="numpy_nullable"
) as reader:
    for chunk in reader:
        train_cols = [c for c in chunk.columns if c in train_set]
        if not train_cols:
            continue

        ch = chunk[train_cols]
        ch = ch.loc[ch.median(axis=1) >= LOW_EXPR_THRESHOLD]
        if ch.empty:
            continue

        med = ch.median(axis=1)
        mad = (ch.sub(med, axis=0)).abs().median(axis=1)
        mad_scores.extend(zip(ch.index, mad))

mad_df = pd.DataFrame(mad_scores, columns=["Gene", "MAD"])
mad_df = mad_df.drop_duplicates("Gene")
mad_df["MAD_z"] = (
    (mad_df["MAD"] - mad_df["MAD"].mean()) /
    mad_df["MAD"].std()
)
top_genes = mad_df.nlargest(TOP_K, "MAD_z")["Gene"].tolist()

if not top_genes:
    raise ValueError("No genes selected. Check the expression matrix and filter.")

log(f"Selected {len(top_genes):,} genes using training samples only.")

# ── 1f. Load selected genes and align samples ─────────────────
chunks = []
with pd.read_csv(
    EXPR_PATH, sep="\t", index_col=0, chunksize=CHUNK_SIZE,
    engine="c", dtype_backend="numpy_nullable"
) as reader:
    for chunk in reader:
        overlap = chunk.index.intersection(top_genes)
        if len(overlap):
            chunks.append(chunk.loc[overlap])

if not chunks:
    raise ValueError("Selected genes were not found in the expression file.")

expr_top = pd.concat(chunks).T
expr_top.index.name = "sample"

common = expr_top.index.intersection(meta.index)
expr_top = expr_top.loc[common]
meta = meta.loc[common]

log(f"Aligned matrix: {expr_top.shape[0]:,} samples x {expr_top.shape[1]:,} genes")

# ── 1g. Create aligned masks ──────────────────────────────────
y_binary = meta["is_tumor"]
y_detailed = meta["_primary_site"].copy()
y_detailed.loc[meta["is_healthy"]] = "HEALTHY"

part = meta["partition"].to_numpy()
healthy_train_mask = part == "healthy_train"
healthy_calib_mask = part == "healthy_calib"
healthy_holdout_mask = part == "healthy_holdout"

eval_tumour_mask = (
    meta["partition"].eq("tumour").to_numpy()
    & meta["is_primary_tumour"].to_numpy()
)
eval_mask = healthy_holdout_mask | eval_tumour_mask

log(f"Training healthy: {healthy_train_mask.sum():,}")
log(f"Calibration healthy: {healthy_calib_mask.sum():,}")
log(f"Holdout healthy: {healthy_holdout_mask.sum():,}")
log(f"Eligible tumour evaluation: {eval_tumour_mask.sum():,}")
log(f"Excluded overlapping TCGA tumours: {exclude_tcga_tumour.sum():,}")

# ── 1h. Fit preprocessing on healthy TRAIN only ────────────────
expr_numeric = expr_top.apply(pd.to_numeric, errors="coerce").astype("float64")

imputer = SimpleImputer(strategy="median", keep_empty_features=True)
imputer.fit(expr_numeric.loc[healthy_train].values)
X_imputed = pd.DataFrame(
    imputer.transform(expr_numeric.values),
    index=expr_numeric.index,
    columns=expr_numeric.columns
)

X_log = np.log2(X_imputed.clip(lower=1e-6) + 1)

scaler = StandardScaler()
scaler.fit(X_log.loc[healthy_train].values)

X_scaled = pd.DataFrame(
    scaler.transform(X_log.values),
    index=X_log.index,
    columns=X_log.columns
)
X_scaled.replace([np.inf, -np.inf], np.nan, inplace=True)
X_scaled = X_scaled.fillna(0.0)
X_scaled_original = X_scaled.copy()

# ── 1i. Mandatory integrity checks ────────────────────────────
assert expr_top.index.equals(meta.index), "Expression/metadata index mismatch."
assert not (set(healthy_train) & set(healthy_calib))
assert not (set(healthy_train) & set(healthy_holdout))
assert not (set(healthy_calib) & set(healthy_holdout))

# No TCGA patient from healthy train/calibration may appear in
# the eligible TCGA tumour evaluation.
train_calib_groups = set(
    meta.loc[meta["partition"].isin(["healthy_train", "healthy_calib"]),
             "patient_group"]
)
eligible_tcga_eval_groups = set(
    meta.loc[
        eval_tumour_mask & (meta["source"].to_numpy() == "TCGA"),
        "patient_group"
    ]
)
assert not (train_calib_groups & eligible_tcga_eval_groups), (
    "Patient overlap remains between healthy train/calibration and TCGA tumour evaluation."
)

log("Step 1 complete. Review counts before running later cells.")



# Recreate patient IDs for the verification check
meta["patient_id"] = meta.index.astype(str).str.extract(
    r"^(TCGA-[A-Z0-9]+-[A-Z0-9]+)", expand=False
)

# Use the current evaluation mask, aligned to meta's row order
eval_patients = set(
    meta.loc[eval_tumour_mask, "patient_id"].dropna()
)

healthy_train_patients = set(
    meta.loc[meta["partition"].eq("healthy_train"), "patient_id"].dropna()
)
healthy_calib_patients = set(
    meta.loc[meta["partition"].eq("healthy_calib"), "patient_id"].dropna()
)
healthy_holdout_patients = set(
    meta.loc[meta["partition"].eq("healthy_holdout"), "patient_id"].dropna()
)

print("Tumour/healthy-train overlap:",
      len(eval_patients & healthy_train_patients))
print("Tumour/healthy-calibration overlap:",
      len(eval_patients & healthy_calib_patients))
print("Tumour/healthy-holdout overlap:",
      len(eval_patients & healthy_holdout_patients))


print("Final expression samples:", len(expr_top))
print("Metadata samples:", len(meta))
print("Sample indexes identical:", expr_top.index.equals(meta.index))
print("\nSample types by source:")
print(pd.crosstab(meta["source"], meta["_sample_type"]))

print("\nPartition counts:")
print(meta["partition"].value_counts(dropna=False))

print("\nTumour labels:")
print(meta.loc[meta["is_primary_tumour"], "is_tumor"].value_counts())


# Check patient overlap between tumour and healthy samples
# TCGA barcode patient ID = first 3 barcode fields

check = meta.copy()
check["sample_id"] = check.index.astype(str)
check["patient_id"] = check["sample_id"].str.extract(
    r"^(TCGA-[A-Z0-9]+-[A-Z0-9]+)", expand=False
)

tcga = check[check["source"] == "TCGA"].copy()

tumour_patients = set(
    tcga.loc[tcga["is_primary_tumour"], "patient_id"].dropna()
)
healthy_patients = set(
    tcga.loc[tcca["is_healthy"], "patient_id"].dropna()
) if False else set(
    tcga.loc[tcga["is_healthy"], "patient_id"].dropna()
)

print("Unique TCGA tumour patients:", len(tumour_patients))
print("Unique TCGA healthy patients:", len(healthy_patients))
print("Patients appearing in both groups:",
      len(tumour_patients & healthy_patients))


import re
import pandas as pd

# Check the patient_group values created in Step 1
check = meta.copy()
check["sample_id"] = check.index.astype(str)

# Extract donor IDs from TCGA and GTEx barcodes
check["expected_donor"] = check["sample_id"]

tcga_mask = check["source"].eq("TCGA")
gtex_mask = check["source"].eq("GTEx")

check.loc[tcga_mask, "expected_donor"] = (
    check.loc[tcga_mask, "sample_id"]
    .str.extract(r"^(TCGA-[A-Z0-9]+-[A-Z0-9]+)", expand=False)
    .fillna(check.loc[tcga_mask, "sample_id"])
)

check.loc[gtex_mask, "expected_donor"] = (
    check.loc[gtex_mask, "sample_id"]
    .str.extract(r"^(GTEX-[A-Z0-9]+)", expand=False)
    .fillna(check.loc[gtex_mask, "sample_id"])
)

# 1. Check whether GTEx donors have multiple samples
gtex = check.loc[gtex_mask]
print("GTEx samples:", len(gtex))
print("Unique GTEx donors:", gtex["expected_donor"].nunique())
print("GTEx donors with multiple samples:",
      int((gtex["expected_donor"].value_counts() > 1).sum()))

# 2. Check whether the existing patient_group matches donor IDs
print("GTEx samples whose patient_group differs from donor ID:",
      int((gtex["patient_group"].astype(str) !=
           gtex["expected_donor"].astype(str)).sum()))

# 3. Check whether any expected donor crosses healthy partitions
healthy = check[
    check["partition"].isin(
        ["healthy_train", "healthy_calib", "healthy_holdout"]
    )
].copy()

donor_partition_counts = (
    healthy.groupby("expected_donor")["partition"].nunique()
)
cross_partition_donors = donor_partition_counts[
    donor_partition_counts > 1
]

print("Healthy donors appearing in multiple partitions:",
      len(cross_partition_donors))
print(cross_partition_donors.head(10))

# ============================================================
# CELL 1B: (optional) ComBat + PCA fitted on healthy-TRAIN only
# ============================================================
combat_output = None
if COMBAT_MODE == "global_original":
    # v1 behaviour. NOT leakage-safe: ComBat is estimated on ALL samples (including the evaluation
    # pool) and protects each sample's tumour/healthy label. Kept only to reproduce v1.
    import subprocess
    subprocess.run([sys.executable, "-m", "pip", "install", "-q", "neuroCombat"], check=False)
    from neuroCombat import neuroCombat
    log("Step 1B-i: ComBat (LEGACY global mode — not leakage-safe)...")
    batch_labels = (meta["cohort"] == "TCGA/TARGET").astype(int).values
    covars = pd.DataFrame({"batch": batch_labels, "is_tumor": y_binary.values})
    try:
        combat_output = neuroCombat(dat=X_scaled.values.T, covars=covars, batch_col="batch",
                                    categorical_cols=["is_tumor"], mean_only=True)
        X_scaled_original = X_scaled.copy()
        X_scaled = pd.DataFrame(combat_output["data"].T, index=X_scaled.index, columns=X_scaled.columns)
        X_scaled.replace([np.inf, -np.inf], np.nan, inplace=True)
        X_scaled = X_scaled.fillna(0.0)
    except Exception as e:
        log(f"  Legacy ComBat could not run ({type(e).__name__}: {e}). The batch label equals the protected "
            f"tumour/healthy covariate, so the design is degenerate. Continuing WITHOUT correction.")
elif COMBAT_MODE == "source_shift":
    log("Step 1B-i: source-shift correction (per-gene mean shift TCGA/TARGET-normal vs GTEx, fitted on healthy-train only)...")
    src_tcga = meta["source"].isin(["TCGA", "TARGET"]).to_numpy()
    g_rows = healthy_train_mask & ~src_tcga
    t_rows = healthy_train_mask & src_tcga
    if g_rows.sum() >= 20 and t_rows.sum() >= 20:
        offset = X_scaled.values[t_rows].mean(axis=0) - X_scaled.values[g_rows].mean(axis=0)
        Xs = X_scaled.values.copy()
        Xs[src_tcga] -= offset                      # applied to every TCGA/TARGET-source sample, incl. tumours
        X_scaled_original = X_scaled.copy()
        X_scaled = pd.DataFrame(Xs, index=X_scaled.index, columns=X_scaled.columns)
        log(f"  Shift estimated from {int(g_rows.sum())} GTEx and {int(t_rows.sum())} TCGA/TARGET-normal training samples.")
    else:
        log("  Not enough healthy-train samples in one source — correction skipped.")
else:
    log("Step 1B-i: ComBat NOT applied (COMBAT_MODE='none'). Batch structure is measured directly in Cell 2.")

