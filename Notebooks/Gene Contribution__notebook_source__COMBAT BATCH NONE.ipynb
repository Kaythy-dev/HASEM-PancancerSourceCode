# PAPER TWO — ADDITIONAL STATISTICAL AUDIT
# Run after Cells 12–20 have completed successfully.

from pathlib import Path
import numpy as np
import pandas as pd
from scipy.stats import mannwhitneyu

OUT = Path("/kaggle/working/paper2_gene_attribution")
results_file = OUT / "Paper2_median_difference_bootstrap.csv"
assert results_file.exists(), f"Missing results file: {results_file}"

res = pd.read_csv(results_file)

# 1. Structural integrity: expected 8 genes × 10 cancers × 2 metrics.
print("Rows:", len(res))
print("Cancer types:", res["cancer_type"].nunique())
print("Genes:", res["gene"].nunique())
print("Metrics:", sorted(res["metric"].dropna().unique()))

assert not res.duplicated(
    ["cancer_type", "gene", "metric"]
).any(), "Duplicate cancer–gene–metric rows detected."

# Do not force 80 comparisons if the actual eligible cohort differs.
comparison_counts = (
    res.groupby("metric")
       .agg(
           comparisons=("gene", "size"),
           cancer_types=("cancer_type", "nunique"),
           genes=("gene", "nunique"),
           min_healthy_n=("healthy_n", "min"),
           max_healthy_n=("healthy_n", "max"),
           min_tumour_n=("tumour_n", "min"),
           max_tumour_n=("tumour_n", "max"),
       )
       .reset_index()
)
print("\nComparison audit:")
print(comparison_counts.to_string(index=False))

# 2. Reconstruct the exact groups used by the analysis.
meta_aligned = meta.reindex(X_scaled.index.astype(str)).copy()
meta_aligned.index = meta_aligned.index.astype(str)

row_position = pd.Series(
    np.arange(len(X_scaled)),
    index=X_scaled.index.astype(str)
)
gene_to_col = {
    str(g): i for i, g in enumerate(X_scaled.columns)
}

healthy_holdout_ids = set(pd.Index(healthy_holdout).astype(str))

healthy = meta_aligned[
    meta_aligned["is_healthy"].fillna(False).astype(bool)
    & meta_aligned["source"].eq("TCGA")
    & meta_aligned.index.isin(healthy_holdout_ids)
].copy()

tumours = meta_aligned[
    meta_aligned["partition"].eq("tumour")
    & meta_aligned["is_primary_tumour"].fillna(False).astype(bool)
].copy()

# 3. Calculate rank-based tests and Cliff's delta for each comparison.
# Positive delta means tumour values tend to be larger than healthy values.
# These are exploratory tests, not causal tests.
test_rows = []

for _, r in res.iterrows():
    cancer, site, gene, metric = (
        r["cancer_type"], r["site"], r["gene"], r["metric"]
    )

    tg = tumours[
        tumours["detailed_category"].eq(cancer)
        & tumours["_primary_site"].eq(site)
    ]
    hg = healthy[healthy["_primary_site"].eq(site)]

    gene_base = str(gene).split(".")[0]
    gene_lookup = {
        str(g).split(".")[0]: i
        for i, g in enumerate(X_scaled.columns.astype(str))
    }
    if gene_base not in gene_lookup:
        raise ValueError(f"Gene not found in model matrix: {gene}")

    ti = row_position.loc[tg.index].to_numpy()
    hi = row_position.loc[hg.index].to_numpy()
    j = gene_lookup[gene_base]

    if metric == "Q":
        a = q_gene_contrib[ti, j]
        b = q_gene_contrib[hi, j]
    elif metric == "absolute_T2":
        a = np.abs(t2_gene_contrib[ti, j])
        b = np.abs(t2_gene_contrib[hi, j])
    else:
        raise ValueError(f"Unexpected metric: {metric}")

    a = np.asarray(a, dtype=float)
    b = np.asarray(b, dtype=float)
    a, b = a[np.isfinite(a)], b[np.isfinite(b)]

    if len(a) == 0 or len(b) == 0:
        p_value, cliffs_delta = np.nan, np.nan
    else:
        u = mannwhitneyu(a, b, alternative="two-sided").statistic
        p_value = mannwhitneyu(
            a, b, alternative="two-sided", method="auto"
        ).pvalue
        cliffs_delta = 2 * u / (len(a) * len(b)) - 1

    pooled_sd = np.sqrt(
        ((len(a)-1) * np.var(a, ddof=1) +
         (len(b)-1) * np.var(b, ddof=1)) /
        max(len(a) + len(b) - 2, 1)
    ) if len(a) > 1 and len(b) > 1 else np.nan

    test_rows.append({
        "cancer_type": cancer,
        "site": site,
        "gene": gene,
        "metric": metric,
        "tumour_n_actual": len(a),
        "healthy_n_actual": len(b),
        "tumour_median_actual": np.median(a) if len(a) else np.nan,
        "healthy_median_actual": np.median(b) if len(b) else np.nan,
        "median_difference_actual": (
            np.median(a) - np.median(b)
            if len(a) and len(b) else np.nan
        ),
        "cliffs_delta": cliffs_delta,
        "pooled_sd": pooled_sd,
        "mann_whitney_p": p_value,
    })

tests = pd.DataFrame(test_rows)

# 4. Benjamini–Hochberg FDR adjustment across all reported tests (both metrics).
# This is conservative for the combined exploratory family.
p = tests["mann_whitney_p"].to_numpy(dtype=float)
valid = np.isfinite(p)
q = np.full(len(p), np.nan)

pv = p[valid]
if len(pv):
    order = np.argsort(pv)
    ranked = pv[order]
    m = len(ranked)
    adjusted_sorted = ranked * m / np.arange(1, m + 1)
    adjusted_sorted = np.minimum.accumulate(adjusted_sorted[::-1])[::-1]
    adjusted_sorted = np.clip(adjusted_sorted, 0, 1)

    adjusted = np.empty(m)
    adjusted[order] = adjusted_sorted
    q[valid] = adjusted

tests["BH_FDR_q"] = q
tests["FDR_q_lt_0.05"] = tests["BH_FDR_q"] < 0.05

# 5. Compare computed medians and sample sizes with saved bootstrap output.
audit = res.merge(
    tests,
    on=["cancer_type", "site", "gene", "metric"],
    how="left",
    validate="one_to_one"
)
audit["tumour_n_matches"] = (
    audit["tumour_n"].astype(int) == audit["tumour_n_actual"]
)
audit["healthy_n_matches"] = (
    audit["healthy_n"].astype(int) == audit["healthy_n_actual"]
)
audit["median_matches"] = np.isclose(
    audit["median_difference"],
    audit["median_difference_actual"],
    rtol=1e-5, atol=1e-8, equal_nan=True
)

audit_path = OUT / "Paper2_statistical_audit.csv"
audit.to_csv(audit_path, index=False)

print("\nIntegrity failures:")
print("Tumour n mismatches:", int((~audit["tumour_n_matches"]).sum()))
print("Healthy n mismatches:", int((~audit["healthy_n_matches"]).sum()))
print("Median-difference mismatches:", int((~audit["median_matches"]).sum()))

print("\nExploratory FDR summary by metric:")
print(
    audit.groupby("metric").agg(
        tests=("gene", "size"),
        FDR_q_below_0_05=("FDR_q_lt_0.05", "sum"),
        median_Cliffs_delta=("cliffs_delta", "median"),
        median_effect_difference=("median_difference_actual", "median"),
    ).to_string()
)

print("\nSaved audit:", audit_path)


# Check for repeated participants in each analysis cohort.
# Inspect the output before deciding on a patient-level method.

candidate_id_cols = [
    c for c in meta_aligned.columns
    if any(term in c.lower() for term in
           ["patient", "participant", "subject", "case_id"])
]

print("Potential participant-ID columns:", candidate_id_cols)

if candidate_id_cols:
    for col in candidate_id_cols:
        print(f"\nColumn: {col}")
        print("Tumour samples:", len(tumours))
        print("Unique non-missing tumour IDs:",
              tumours[col].dropna().nunique())
        print("Tumour rows with missing IDs:", tumours[col].isna().sum())
        print("Healthy samples:", len(healthy))
        print("Unique non-missing healthy IDs:",
              healthy[col].dropna().nunique())
else:
    print(
        "No obvious participant-ID column detected. "
        "Inspect the metadata schema and sample identifiers manually."
    )


