# PAPER TWO — REBUILD ALL-GENE BENCHMARK WITH ORIGINAL HEALTHY REFERENCE
# Replaces benchmark_all_genes with a fresh, cohort-matched version.

import numpy as np
import pandas as pd

meta_bench = meta.reindex(X_scaled.index)

# Exact sample IDs from the original healthy reference
original_healthy_ids = set(healthy.index.astype(str))

healthy_mask = (
    meta_bench.index.astype(str).isin(original_healthy_ids)
)

tumour_mask = (
    meta_bench["partition"].eq("tumour")
    & meta_bench["is_tumor"].eq(1)
)

# Verify sample alignment and cohort sizes
assert X_scaled.index.is_unique
assert meta_bench.index.equals(X_scaled.index)
assert int(healthy_mask.sum()) == len(original_healthy_ids) == 109
assert int(tumour_mask.sum()) == 8502

# Verify all original healthy samples are in the expression matrix
assert original_healthy_ids.issubset(set(X_scaled.index.astype(str)))


cancer_sites = {
    "Breast Invasive Carcinoma": "Breast",
    "Head & Neck Squamous Cell Carcinoma": "Head and Neck region",
    "Kidney Chromophobe": "Kidney",
    "Kidney Clear Cell Carcinoma": "Kidney",
    "Kidney Papillary Cell Carcinoma": "Kidney",
    "Liver Hepatocellular Carcinoma": "Liver",
    "Lung Adenocarcinoma": "Lung",
    "Lung Squamous Cell Carcinoma": "Lung",
    "Prostate Adenocarcinoma": "Prostate",
    "Thyroid Carcinoma": "Thyroid Gland",
}

# Precompute the sample indices for each cancer and its healthy reference site
cohorts = {}

for cancer_type, site in cancer_sites.items():
    tumour_idx = meta_bench.index[
        tumour_mask
        & meta_bench["primary disease or tissue"].eq(cancer_type)
    ]

    healthy_idx = meta_bench.index[
        healthy_mask
        & meta_bench["_primary_site"].eq(site)
    ]

    assert len(tumour_idx) > 0, f"No tumour samples for {cancer_type}"
    assert len(healthy_idx) > 0, f"No healthy reference for {site}"

    cohorts[cancer_type] = {
        "site": site,
        "tumour_idx": tumour_idx,
        "healthy_idx": healthy_idx,
    }

    print(
        f"{cancer_type}: tumour n={len(tumour_idx)}, "
        f"healthy n={len(healthy_idx)}"
    )

# Use the existing gene-contribution arrays.
# Rows must correspond to X_scaled.index and columns to X_scaled.columns.
assert q_gene_contrib.shape == X_scaled.shape
assert abs(t2_gene_contrib).shape == X_scaled.shape

gene_ids = X_scaled.columns.astype(str).to_numpy()
q_values = np.asarray(q_gene_contrib)
t2_values = np.abs(np.asarray(t2_gene_contrib))

assert np.isfinite(q_values).all()
assert np.isfinite(t2_values).all()

sample_positions = {
    sample_id: i
    for i, sample_id in enumerate(X_scaled.index.astype(str))
}

# Calculate the median difference for each gene:
# tumour median minus site-matched healthy median.
benchmark_rows = []

for cancer_type, cohort in cohorts.items():
    tumour_pos = np.array([
        sample_positions[s]
        for s in cohort["tumour_idx"].astype(str)
    ], dtype=int)

    healthy_pos = np.array([
        sample_positions[s]
        for s in cohort["healthy_idx"].astype(str)
    ], dtype=int)

    for metric, values in [
        ("Q", q_values),
        ("absolute_T2", t2_values),
    ]:
        tumour_medians = np.median(values[tumour_pos, :], axis=0)
        healthy_medians = np.median(values[healthy_pos, :], axis=0)
        differences = tumour_medians - healthy_medians

        for j, gene in enumerate(gene_ids):
            benchmark_rows.append({
                "cancer_type": cancer_type,
                "site": cohort["site"],
                "gene": gene,
                "metric": metric,
                "tumour_n": len(tumour_pos),
                "healthy_n": len(healthy_pos),
                "tumour_median": float(tumour_medians[j]),
                "healthy_median": float(healthy_medians[j]),
                "median_difference": float(differences[j]),
            })

benchmark_all_genes = pd.DataFrame(benchmark_rows)

print("\nRebuilt benchmark shape:", benchmark_all_genes.shape)
print("Unique genes:", benchmark_all_genes["gene"].nunique())
print("Cancer types:", benchmark_all_genes["cancer_type"].nunique())
print("\nRows per metric:")
print(benchmark_all_genes["metric"].value_counts().to_string())


