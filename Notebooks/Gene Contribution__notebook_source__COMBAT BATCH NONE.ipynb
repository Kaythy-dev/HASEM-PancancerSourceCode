# ============================================================
if COMBAT_MODE != "source_shift":
    print("Sensitivity diagnostic skipped: rerun with HASEM_COMBAT_MODE=source_shift.")
else:
    import os
    import numpy as np
    import pandas as pd
    from sklearn.decomposition import PCA
    from sklearn.linear_model import LogisticRegression
    from sklearn.metrics import roc_auc_score

    assert "X_scaled_original" in globals(), "X_scaled_original missing: rerun the notebook from the beginning."
    assert X_scaled.shape == X_scaled_original.shape
    assert len(meta) == X_scaled.shape[0]

    X_before = X_scaled_original.to_numpy(dtype=np.float64, copy=False)
    X_after  = X_scaled.to_numpy(dtype=np.float64, copy=False)
    source = meta["source"].astype(str).to_numpy()
    is_healthy = meta["is_healthy"].astype(bool).to_numpy()
    is_tumour = (partition == "tumour") & meta["is_primary_tumour"].astype(bool).to_numpy()
    partition = meta["partition"].astype(str).to_numpy()

    # Match the existing source classifier design: train healthy-train,
    # evaluate healthy-holdout, GTEx versus TCGA/TARGET.
    train_mask = is_healthy & (partition == "healthy_train") & np.isin(source, ["GTEx", "TCGA", "TARGET"])
    hold_mask  = is_healthy & (partition == "healthy_holdout") & np.isin(source, ["GTEx", "TCGA", "TARGET"])

    def source_auc(X, label):
        y_train = (source[train_mask] != "GTEx").astype(int)
        y_hold = (source[hold_mask] != "GTEx").astype(int)
        clf = LogisticRegression(max_iter=1000, solver="saga", random_state=RANDOM_SEED)
        clf.fit(X[train_mask], y_train)
        p = clf.predict_proba(X[hold_mask])[:, 1]
        return roc_auc_score(y_hold, p)

    auc_source_before = source_auc(X_before, "before")
    auc_source_after = source_auc(X_after, "after")

    # Fit separate healthy-train PCA models before and after correction.
    # Compare tumour-vs-healthy discrimination within TCGA/TARGET only.
    # Healthy evaluation samples are held-out; tumours are never used to fit PCA.
    pca_before = PCA(n_components=VAR_EXPLAINED, svd_solver="full", random_state=RANDOM_SEED)
    pca_after  = PCA(n_components=VAR_EXPLAINED, svd_solver="full", random_state=RANDOM_SEED)
    pca_before.fit(X_before[healthy_train_mask])
    pca_after.fit(X_after[healthy_train_mask])

    def get_scores(X, pca):
        scores = pca.transform(X)
        recon = pca.inverse_transform(scores)
        resid = X - recon
        eig = np.maximum(pca.explained_variance_, 1e-12)
        t2 = np.sum((scores ** 2) / eig, axis=1)
        q = np.sum(resid ** 2, axis=1)
        return t2, q

    t2_before, q_before = get_scores(X_before, pca_before)
    t2_after, q_after = get_scores(X_after, pca_after)

    source_tcga = np.isin(source, ["TCGA", "TARGET"])
    eval_mask = source_tcga & (is_tumour | (is_healthy & (partition == "healthy_holdout")))
    y_eval = is_tumour[eval_mask].astype(int)

    def auc_or_nan(y, score):
        return float(roc_auc_score(y, score)) if len(np.unique(y)) == 2 else np.nan

    biological_rows = []
    for metric, s_before, s_after in [
        ("Q", q_before, q_after),
        ("T2", t2_before, t2_after),
    ]:
        biological_rows.append({
            "diagnostic": "TCGA_TARGET tumour_vs_heldout_healthy_auc",
            "metric": metric,
            "before_correction_auc": auc_or_nan(y_eval, s_before[eval_mask]),
            "after_correction_auc": auc_or_nan(y_eval, s_after[eval_mask]),
            "n_healthy_holdout": int(np.sum(eval_mask & is_healthy)),
            "n_primary_tumours": int(np.sum(eval_mask & is_tumour)),
            "pca_components_before": int(pca_before.n_components_),
            "pca_components_after": int(pca_after.n_components_),
            "variance_explained_before": float(pca_before.explained_variance_ratio_.sum()),
            "variance_explained_after": float(pca_after.explained_variance_ratio_.sum()),
        })

    # Check whether healthy tissue labels overlap across source groups.
    healthy = meta.loc[is_healthy].copy()
    healthy["source_group"] = np.where(healthy["source"].isin(["TCGA", "TARGET"]), "TCGA_TARGET", "GTEx")
    tissue_col = "primary disease or tissue"
    if tissue_col in healthy.columns:
        tissue_by_source = pd.crosstab(healthy[tissue_col].astype(str), healthy["source_group"])
        overlap_tissues = int(((tissue_by_source.get("GTEx", 0) > 0) &
                               (tissue_by_source.get("TCGA_TARGET", 0) > 0)).sum())
    else:
        overlap_tissues = -1

    # For an additive shift, within-TCGA/TARGET per-gene variance should be invariant.
    tcga_all = source_tcga
    var_before = np.var(X_before[tcga_all], axis=0, ddof=1)
    var_after = np.var(X_after[tcga_all], axis=0, ddof=1)
    max_abs_variance_change = float(np.max(np.abs(var_before - var_after)))
    median_abs_variance_change = float(np.median(np.abs(var_before - var_after)))

    summary_rows = [
        {"diagnostic": "healthy_source_classifier_auc", "metric": "source", 
         "before_correction_auc": auc_source_before, "after_correction_auc": auc_source_after,
         "n_healthy_holdout": int(hold_mask.sum()), "n_primary_tumours": np.nan,
         "pca_components_before": np.nan, "pca_components_after": np.nan,
         "variance_explained_before": np.nan, "variance_explained_after": np.nan},
        *biological_rows,
        {"diagnostic": "healthy_tissue_label_overlap_between_sources", "metric": tissue_col,
         "before_correction_auc": np.nan, "after_correction_auc": np.nan,
         "n_healthy_holdout": int(hold_mask.sum()), "n_primary_tumours": np.nan,
         "pca_components_before": np.nan, "pca_components_after": np.nan,
         "variance_explained_before": np.nan, "variance_explained_after": np.nan,
         "overlapping_tissue_labels": overlap_tissues},
        {"diagnostic": "within_TCGA_TARGET_gene_variance_invariance", "metric": "variance",
         "before_correction_auc": np.nan, "after_correction_auc": np.nan,
         "n_healthy_holdout": np.nan, "n_primary_tumours": np.nan,
         "pca_components_before": np.nan, "pca_components_after": np.nan,
         "variance_explained_before": np.nan, "variance_explained_after": np.nan,
         "max_abs_gene_variance_change": max_abs_variance_change,
         "median_abs_gene_variance_change": median_abs_variance_change},
    ]
    audit = pd.DataFrame(summary_rows)
    audit_path = os.path.join(OUTDIR, "correction_signal_preservation_audit.csv")
    audit.to_csv(audit_path, index=False)

    print("=== IMPROVEMENT 2: CORRECTION ROBUSTNESS AUDIT ===")
    print(f"Healthy source classifier AUC: {auc_source_before:.4f} before -> {auc_source_after:.4f} after")
    print(f"Healthy source train/holdout: {int(train_mask.sum())} / {int(hold_mask.sum())}")
    print(f"Healthy tissue labels shared across GTEx and TCGA/TARGET: {overlap_tissues}")
    print(f"Within TCGA/TARGET max absolute per-gene variance change: {max_abs_variance_change:.8g}")
    print("\nTumour-vs-heldout-healthy discrimination within TCGA/TARGET:")
    print(pd.DataFrame(biological_rows).to_string(index=False))
    print(f"\nSaved: {audit_path}")
    print("\nInterpretation caution: AUC changes are descriptive diagnostics, not proof of biological preservation.")
    print("If shared healthy tissue labels = 0, source and tissue effects cannot be fully separated using this cohort alone.")



