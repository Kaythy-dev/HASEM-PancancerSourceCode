import pandas as pd
import numpy as np

candidate_ids = {
    "ADH1B": "ENSG00000196616.12",
    "CDH19": "ENSG00000071991.8",
    "SCN3A": "ENSG00000153253.15",
    "PI16": "ENSG00000164530.13",
    "CA4": "ENSG00000167434.9",
    "PLCXD3": "ENSG00000182836.9",
    "TRHDE-AS1": "ENSG00000236333.3",
    "ZBTB16": "ENSG00000109906.13",
}

print("=== 1. Healthy holdout partition counts ===")
print(
    meta.loc[meta["partition"].eq("healthy_holdout"),
             ["sample", "_sample_type", "source", "_primary_site"]]
    .groupby(["_sample_type", "source", "_primary_site"],
             dropna=False)
    .size()
    .sort_values(ascending=False)
    .to_string()
)

print("\n=== 2. Healthy samples used in the original reference ===")
print("Original healthy n:", len(healthy))
print("Original healthy IDs:", healthy.index.tolist())

print("\n=== 3. Candidate gene median reconciliation ===")

orig = res.copy()
orig["gene"] = orig["gene"].astype(str)

candidate_gene_set = set(candidate_ids.values())
orig = orig[orig["gene"].isin(candidate_gene_set)]

new = benchmark_all_genes[
    benchmark_all_genes["gene"].isin(candidate_gene_set)
].copy()

audit = orig.merge(
    new,
    on=["cancer_type", "site", "gene", "metric"],
    how="outer",
    suffixes=("_original", "_new"),
    indicator=True
)

for col in ["tumour_n", "healthy_n", "tumour_median",
            "healthy_median", "median_difference"]:
    audit[f"{col}_delta"] = (
        audit[f"{col}_new"] - audit[f"{col}_original"]
    )

print("Merge status:")
print(audit["_merge"].value_counts().to_string())

for col in ["tumour_n", "healthy_n"]:
    print(f"\n{col} mismatches:",
          int((audit[f"{col}_delta"].fillna(0) != 0).sum()))

for col in ["tumour_median", "healthy_median", "median_difference"]:
    print(f"{col} maximum absolute difference:",
          audit[f"{col}_delta"].abs().max())

print("\nRows with healthy count mismatch:")
print(
    audit.loc[
        audit["healthy_n_delta"].fillna(0) != 0,
        ["cancer_type", "site", "gene", "metric",
         "healthy_n_original", "healthy_n_new"]
    ].drop_duplicates().to_string(index=False)
)

print("\nRows with median difference greater than 1e-8:")
median_cols = [
    "tumour_median_delta",
    "healthy_median_delta",
    "median_difference_delta",
]
print(
    audit.loc[
        (audit[median_cols].abs() > 1e-8).any(axis=1),
        ["cancer_type", "gene", "metric"] + median_cols
    ].head(30).to_string(index=False)
)




