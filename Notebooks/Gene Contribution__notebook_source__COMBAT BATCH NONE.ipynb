import numpy as np
from scipy.linalg import svd

# Healthy-training residuals
E_train = np.asarray(
    residuals[healthy_train_mask],
    dtype=np.float64
)

n = E_train.shape[0]

# Singular values of the centred residual matrix.
# Covariance eigenvalues are squared singular values / (n - 1).
singular_values = svd(
    E_train,
    full_matrices=False,
    compute_uv=False,
    check_finite=False,
    lapack_driver="gesdd"
)

lambda_resid = (singular_values ** 2) / (n - 1)

# Remove numerical zero eigenvalues.
lambda_resid = lambda_resid[lambda_resid > 1e-10]

# Jackson-Mudholkar residual covariance moments
theta1_cov = np.sum(lambda_resid)
theta2_cov = np.sum(lambda_resid ** 2)
theta3_cov = np.sum(lambda_resid ** 3)

h0_cov = 1 - (
    2 * theta1_cov * theta3_cov
    / (3 * theta2_cov ** 2)
)

from scipy.stats import norm

z_alpha = norm.ppf(1 - ANOMALY_ALPHA)

Q_thresh_JM_cov = theta1_cov * (
    1
    + z_alpha * np.sqrt(2 * theta2_cov * h0_cov ** 2)
      / theta1_cov
    + theta2_cov * h0_cov * (h0_cov - 1)
      / theta1_cov ** 2
) ** (1 / h0_cov)

print("Residual covariance eigenvalues:", len(lambda_resid))
print("Theta 1:", theta1_cov)
print("Theta 2:", theta2_cov)
print("Theta 3:", theta3_cov)
print("h0:", h0_cov)
print("Corrected JM Q threshold:", Q_thresh_JM_cov)
print("Empirical Q threshold:", Q_thresh_emp)


