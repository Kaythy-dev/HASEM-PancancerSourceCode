    delta = audit[f"{col}_new"] - audit[f"{col}_original"]
    print(
        f"{col} maximum absolute difference:",
        delta.abs().max()
    )

print("\n=== OVERALL PASS/FAIL ===")
row_match = (audit["_merge"] == "both").all()

count_match = all(
    (audit[f"{col}_new"] == audit[f"{col}_original"]).all()
    for col in ["tumour_n", "healthy_n"]
)

median_match = all(
    np.allclose(
        audit[f"{col}_new"],
        audit[f"{col}_original"],
        rtol=1e-8,
        atol=1e-8,
        equal_nan=True
    )
    for col in [
        "tumour_median",
        "healthy_median",
        "median_difference"
    ]
)

print("Rows match:", row_match)
print("Sample counts match:", count_match)
print("Medians match:", median_match)
print("VALIDATION PASSED:", row_match and count_match and median_match)


# PAPER TWO — RANDOM GENE-SET BENCHMARK
# Compares the 8 candidate genes with 10,000 random sets of 8 genes.
# Uses only the already validated benchmark_all_genes table.

import numpy as np
import pandas as pd

SEED = 20261029
N_RANDOM_SETS = 10_000

candidate_ids = {
    "ADH1B": "ENSG00000196616.12",
    "CDH19": "ENSG00000071991.8",
    "SCN3A": "ENSG00000153253.15",
    "PI16": "ENSG00000164530.13",
    "CA4": "ENSG00000167434.9",
    "PLCXD3": "ENSG00000182836.9",
    "TRHDE-AS1": "ENSG00000236333.3",
    "ZBTB16": "ENSG00000109906.13",
}

candidate_set = set(candidate_ids.values())

# One column per cancer type × metric; one row per gene.
rank_table = benchmark_all_genes.pivot(
    index="gene",
    columns=["cancer_type", "metric"],
    values="median_difference"
)

assert rank_table.shape == (5000, 20), (
    f"Unexpected rank-table shape: {rank_table.shape}"
)
assert not rank_table.isna().any().any()
assert candidate_set.issubset(set(rank_table.index))

# Rank genes within each cancer × metric.
# Percentile ranks range approximately from 0 to 1.
percentile_ranks = rank_table.rank(
    axis=0,
    method="average",
    pct=True
)

# Each gene's average percentile rank across all 20 contexts.
gene_scores = percentile_ranks.mean(axis=1)

candidate_scores = gene_scores.loc[
    sorted(candidate_set)
]

observed_score = float(candidate_scores.mean())

# Generate random sets of 8 distinct genes.
rng = np.random.default_rng(SEED)
all_genes = gene_scores.index.to_numpy()
n_genes = len(all_genes)
n_candidates = len(candidate_set)

random_scores = np.empty(N_RANDOM_SETS)

for i in range(N_RANDOM_SETS):
    sampled_genes = rng.choice(
        all_genes,
        size=n_candidates,
        replace=False
    )
    random_scores[i] = gene_scores.loc[sampled_genes].mean()

# Empirical one-sided p-value:
# Is the candidate set's average rank unusually high?
empirical_p = (
    1 + np.sum(random_scores >= observed_score)
) / (N_RANDOM_SETS + 1)

null_mean = float(random_scores.mean())
null_sd = float(random_scores.std(ddof=1))
null_q95 = float(np.quantile(random_scores, 0.95))
null_q99 = float(np.quantile(random_scores, 0.99))

print("=== RANDOM GENE-SET BENCHMARK ===")
print("Candidate genes:", n_candidates)
print("Random gene sets:", N_RANDOM_SETS)
print("Contexts:", rank_table.shape[1])
print(f"Observed candidate mean percentile rank: {observed_score:.4f}")
print(f"Random-set mean: {null_mean:.4f}")
print(f"Random-set SD: {null_sd:.4f}")
print(f"Random-set 95th percentile: {null_q95:.4f}")
print(f"Random-set 99th percentile: {null_q99:.4f}")
print(f"Empirical one-sided p-value: {empirical_p:.6f}")
print(
    "Candidate score above random-set 95th percentile:",
    observed_score > null_q95
)

print("\n=== INDIVIDUAL CANDIDATE GENE SCORES ===")
print(
    candidate_scores.sort_values(ascending=False)
    .rename("mean_percentile_rank")
    .to_string()
)

# Save results for later reproducibility and plotting.
random_benchmark_summary = pd.DataFrame([{
    "n_candidate_genes": n_candidates,
    "n_random_sets": N_RANDOM_SETS,
    "n_contexts": rank_table.shape[1],
    "observed_mean_percentile_rank": observed_score,
    "random_set_mean": null_mean,
    "random_set_sd": null_sd,
    "random_set_q95": null_q95,
    "random_set_q99": null_q99,
    "empirical_one_sided_p": empirical_p,
    "random_seed": SEED,
}])

random_benchmark_summary.to_csv(
    "paper_two_random_gene_benchmark_summary.csv",
    index=False
)

pd.DataFrame({
    "random_set_mean_percentile_rank": random_scores
}).to_csv(
    "paper_two_random_gene_set_null_distribution.csv",
    index=False
)

print("\nSaved benchmark summary and null distribution CSV files.")


